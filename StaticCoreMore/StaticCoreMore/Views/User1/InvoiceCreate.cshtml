
@{
    Layout = "~/views/shared/_user1layout.cshtml";
}

<!-- App body starts -->
<div class="app-body">

    <!-- Row start -->
    <div class="row gx-4">
        <div class="col-xxl-9 col-sm-12">

            <div class="card mb-4">
                <div class="card-body">
                    <div class="rounded-2 mb-4">

                        <!-- Row start -->
                        <div class="row gx-4">
                            <div class="col-sm-6 col-12">
                                <div class="mb-3">
                                    <img src="assets/images/logo-dark.svg" class="invoice-logo" alt="Admin Templates">
                                </div>
                                <p class="m-0">
                                    Maximo Vasquez,<br>
                                    Suite 668 1642 Wintheiser Ways,<br>
                                    Port Paola,<br>
                                    CO 69990-9851
                                </p>
                            </div>
                            <div class="col-sm-6 col-12">
                                <!-- Row start -->
                                <div class="row">
                                    <div class="col-sm-12 col-12">
                                        <!-- Form group start -->
                                        <div class="mb-2">
                                            <label for="invNumber" class="form-label">Invoice Number</label>
                                            <input type="text" id="invNumber" class="form-control" placeholder="Enter Invoice Number">
                                        </div>
                                        <!-- Form group end -->
                                    </div>
                                    <div class="col-sm-6 col-12">
                                        <!-- Form group start -->
                                        <div class="mb-2">
                                            <label for="invoiceDate" class="form-label">Invoice Date</label>
                                            <div class="input-group">
                                                <input type="text" class="form-control datepicker-opens-left" id="invoiceDate" placeholder="DD/MM/YYYY">
                                                <span class="input-group-text">
                                                    <i class="bi bi-calendar"></i>
                                                </span>
                                            </div>
                                        </div>
                                        <!-- Form group end -->
                                    </div>
                                    <div class="col-sm-6 col-12">
                                        <!-- Form group start -->
                                        <div class="mb-2">
                                            <label for="dueDate" class="form-label">Due Date</label>
                                            <div class="input-group">
                                                <input type="text" class="form-control datepicker-opens-left" id="dueDate" placeholder="DD/MM/YYYY">
                                                <span class="input-group-text">
                                                    <i class="bi bi-calendar"></i>
                                                </span>
                                            </div>
                                        </div>
                                        <!-- Form group end -->
                                    </div>
                                    <div class="col-sm-12 col-12">
                                        <!-- Form group start -->
                                        <div>
                                            <label for="msgCustomer" class="form-label">Message</label>
                                            <textarea rows="2" id="msgCustomer" class="form-control"></textarea>
                                        </div>
                                        <!-- Form group end -->
                                    </div>
                                </div>
                                <!-- Row end -->
                            </div>
                        </div>
                        <!-- Row end -->

                    </div>

                    <!-- Row start -->
                    <div class="row gx-4">
                        <div class="col-12">
                            <div class="table-outer mb-2 bg-white">
                                <div class="table-responsive">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Product</th>
                                                <th width="120px">Quantity</th>
                                                <th width="120px">Unit</th>
                                                <th width="120px">Price</th>
                                                <th width="120px">VAT</th>
                                                <th width="120px">Amount (Net)</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <!-- Form group start -->
                                                    <select class="form-select" id="fc11" aria-label="Select Product">
                                                        <option>Select Product</option>
                                                        <option>Mobiles</option>
                                                        <option>Books</option>
                                                        <option>Clothing</option>
                                                        <option>Electronics</option>
                                                        <option>Food</option>
                                                        <option>Games</option>
                                                        <option>Gifts</option>
                                                        <option>Laptops</option>
                                                        <option>Mobiles</option>
                                                        <option>Music</option>
                                                        <option>Office</option>
                                                        <option>Pharmacy</option>
                                                        <option>Sports</option>
                                                        <option>Toys</option>
                                                    </select>
                                                    <!-- Form group end -->
                                                </td>
                                                <td>
                                                    <!-- Form group start -->
                                                    <div class="m-0">
                                                        <input type="number" class="form-control" id="qty" placeholder="Qty">
                                                    </div>
                                                    <!-- Form group end -->
                                                </td>
                                                <td>
                                                    <!-- Form group start -->
                                                    <div class="m-0">
                                                        <input type="text" id="fc1" class="form-control" placeholder="Unit" aria-label="Unit">
                                                    </div>
                                                    <!-- Form group end -->
                                                </td>
                                                <td>
                                                    <!-- Form group start -->
                                                    <div class="input-group m-0">
                                                        <input type="text" id="fc2" class="form-control" placeholder="Price" aria-label="Price">
                                                        <span class="input-group-text">
                                                            <i class="bi bi-currency-dollar"></i>
                                                        </span>
                                                    </div>
                                                    <!-- Form group end -->
                                                </td>
                                                <td>
                                                    <!-- Form group start -->
                                                    <div class="input-group m-0">
                                                        <input type="text" id="fc3" class="form-control" placeholder="VAT %" aria-label="VAT Percentage">
                                                        <span class="input-group-text">
                                                            <i class="bi bi-percent"></i>
                                                        </span>
                                                    </div>
                                                    <!-- Form group end -->
                                                </td>
                                                <td>
                                                    <!-- Form group start -->
                                                    <div class="input-group m-0">
                                                        <input type="text" id="fc4" class="form-control" placeholder="Amount" aria-label="Amount">
                                                        <span class="input-group-text">
                                                            <i class="bi bi-currency-dollar"></i>
                                                        </span>
                                                    </div>
                                                    <!-- Form group end -->
                                                </td>
                                                <td>
                                                    <div class="d-inline-flex gap-2">
                                                        <button type="button" class="btn btn-outline-danger btn-icon" title="Delete row">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                        <button type="button" class="btn btn-outline-success btn-icon" title="Edit row">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <button type="button" class="btn btn-primary">
                                                        Add New Row
                                                    </button>
                                                </td>
                                                <td colspan="6">
                                                    <div class="d-flex gap-2">
                                                        <div class="ms-auto">
                                                            <label class="col-form-label" for="fc10">Discount % of Total Amount</label>
                                                        </div>
                                                        <div class="col-auto">
                                                            <input type="text" id="fc10" class="form-control" placeholder="0%">
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="5">&nbsp;</td>
                                                <td colspan="2" class="text-end">
                                                    <p>Subtotal: $0.00</p>
                                                    <p>Discount: $0.00</p>
                                                    <p>VAT: $0.00</p>
                                                    <h5 class="mt-2 text-danger">Total USD: $0.00</h5>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex justify-content-end gap-1">
                                <button type="button" class="btn btn-outline-primary">
                                    Save as Draft
                                </button>
                                <button type="button" class="btn btn-outline-primary">
                                    Send Invoice
                                </button>
                                <button type="button" class="btn btn-outline-primary">
                                    Preview
                                </button>
                                <a href="invoice-list.html" class="btn btn-primary">Create Invoice</a>
                            </div>
                        </div>
                    </div>
                    <!-- Row end -->
                </div>
            </div>

        </div>
        <div class="col-xxl-3 col-sm-12">
            <div class="card mb-4 bg-primary-subtle">
                <div class="card-body">
                    <div class="text-">
                        <div class="mb-4">
                            <h5 class="text-primary">Mode of Payment</h5>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            <button type="button" class="btn btn-primary btn-sm">Credit/Debit Card</button>
                            <button type="button" class="btn btn-outline-primary btn-sm">UPI</button>
                        </div>
                        <div class="bg-white rounded-2 p-3">

                            <div class="mb-2">
                                <label for="cardNo" class="form-label">Card Number</label>
                                <input type="text" class="form-control form-control-sm" id="cardNo" placeholder="1234 1234 1234 XXXX">
                            </div>

                            <div class="mb-2">
                                <label for="uName" class="form-label">Card Holder Name</label>
                                <input type="text" class="form-control form-control-sm" id="uName" placeholder="Card Holder Name">
                            </div>

                            <div>
                                <label for="enterOtp" class="form-label">Enter OTP</label>
                                <input type="text" class="form-control form-control-sm" id="enterOtp" placeholder="Enter OTP">
                            </div>

                            <div class="d-grid my-4">
                                <button type="button" class="btn btn-black">Pay Now</button>
                            </div>

                            <div class="alert alert-primary m-0 border-0">
                                Please make sure pay the invoice bill within 45 days.
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Row end -->



</div>
<!-- App body ends -->